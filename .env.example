# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Production database and stable signing and encryption keys.
DATABASE_URL=
BETTER_AUTH_SECRET=
SECRETS_ENCRYPTION_KEY=
BETTER_AUTH_URL=

# Private S3-compatible storage. Do not set a public bucket URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AGENT_NATIVE_PRIVATE_BLOB_PUBLIC_UPLOAD_FALLBACK=0

# Email must work before member accounts are offered.
RESEND_API_KEY=
EMAIL_FROM=

# Keep closed until real-domain email and member readiness are approved.
EIGHTY_REGISTRATION_ENABLED=0

# Demo with made-up members. Optional; these are the defaults.
# EIGHTY_DEMO_ENABLED=1
# EIGHTY_DEMO_STARTS_PER_VISITOR_HOUR=5
# EIGHTY_DEMO_STARTS_PER_HOUR=120
